# Copy to ~/.hermes/.env — NEVER commit the real file.
# Everything credential-shaped lives here and is loaded by the gateway/scripts at runtime.

# --- Telegram (BotFather token + your personal chat id for alerts) ---
TELEGRAM_BOT_TOKEN=123456789:ABC-your-botfather-token
TELEGRAM_ALERT_CHAT_ID=123456789

# --- LLM endpoint (Ollama Cloud; any OpenAI-compatible base URL works) ---
# https://ollama.com → generate API key
OLLAMA_API_KEY=sk-your-ollama-cloud-key
OLLAMA_BASE_URL=https://ollama.com/v1

# NOTE for mem0 users: mem0's OSS factory creates an OpenAI client for the LLM leg
# even when pointing at a non-OpenAI base URL. Exporting this dummy works around the
# 401 its constructor throws before you can inject the real key:
OPENAI_API_KEY=sk-dummy-key